{
  "name": "portafolio-juan-de-abreu",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio personal de Juan De Abreu (sitio estatico para GitHub Pages)",
  "scripts": {
    "build": "node tools/sync-cv-button.mjs && npm run build:css",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --watch",
    "sync:cv": "node tools/sync-cv-button.mjs",
    "optimize:images": "node tools/optimize-images.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19"
  }
}
